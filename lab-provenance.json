  "documentPages": [
    {
      "id": 50,
      "title": "Sales Command Center",
      "sourceDocument": "Updated Prompts.docx",
      "documentSha256": "2219798da7fc90af5c8d99acc52f2dab7671287b89524379a557c4ead563b43a",
      "sourceVideo": "video17145987963.mp4",
      "videoSha256": "e551f27607032ccac621f736c475bbfc51edc8e52f47a381e66289a24103a256",
      "paragraphs": [
        {
          "index": 2,
          "text": "Create a sales workspace that helps me identify which opportunities need attention first."
        },
        {
          "index": 3,
          "text": "Start with one section called “Priority Opportunities”, using any existing published workflow that is relevant."
        },
        {
          "index": 4,
          "text": "Show the workflow’s opportunity list and priority explanations when the application opens. Let me use Ask Oracle to explore these opportunities and understand recommended next steps."
        },
        {
          "index": 5,
          "text": "I want the app to be with 2 columns layout."
        },
        {
          "index": 8,
          "text": "Add a “Strategic Accounts” section below “Priority Opportunities” to help me identify which customer accounts deserve attention."
        },
        {
          "index": 9,
          "text": "Show up to five accounts with:"
        },
        {
          "index": 10,
          "text": "Account name."
        },
        {
          "index": 11,
          "text": "Key risks, growth opportunities, or approaching renewals, where information is available."
        },
        {
          "index": 12,
          "text": "A short explanation of why each account deserves attention."
        },
        {
          "index": 13,
          "text": "A suggested next step supported by the available information."
        },
        {
          "index": 14,
          "text": "Let me use Ask Oracle to explore these accounts, understand the recommendations, and prepare for customer conversations."
        },
        {
          "index": 15,
          "text": "Use actual available Sales data and clearly indicate missing information. Keep the experience informational, with business records unchanged and no emails sent."
        },
        {
          "index": 16,
          "text": "Keep the existing Priority Opportunities section working. Use English throughout and prepare the enhanced application for preview."
        },
        {
          "index": 20,
          "text": "Add a “Pre-Meeting Briefs” section type multicard  Priority Opportunities section, to help me prepare for for upcoming customer meetings."
        },
        {
          "index": 21,
          "text": "Show all her meetings scheduled within the next seven days, calculated from the current system time. Use actual Sales meeting data and the existing published meeting-preparation capability."
        },
        {
          "index": 22,
          "text": "When the application opens, show a card for each meeting with:"
        },
        {
          "index": 23,
          "text": "Meeting subject, date and time."
        },
        {
          "index": 24,
          "text": "Customer account and related opportunity, where available."
        },
        {
          "index": 25,
          "text": "Contacts, owner and location."
        },
        {
          "index": 26,
          "text": "A tailored preparation brief based on the meeting’s agenda and available information."
        },
        {
          "index": 27,
          "text": "Three suggested customer questions and three practical next steps."
        },
        {
          "index": 28,
          "text": "Keep all information directly visible using standard supported cards, without expandable controls or time-zone captions. Clearly identify missing information and distinguish no matching meetings from a retrieval problem."
        },
        {
          "index": 29,
          "text": "Let me use Ask Oracle to prepare for a specific meeting, explore the suggested questions, and draft a follow-up message for review."
        },
        {
          "index": 30,
          "text": "Keep the other sections working. Use English throughout, leave business records unchanged, and do not send emails."
        },
        {
          "index": 31,
          "text": "If there is any existing workflow  related to this that you can use, please use it."
        }
      ],
